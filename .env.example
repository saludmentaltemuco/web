# ===============================================
# Salud Mental Temuco - Environment Variables
# ===============================================
# Copia este archivo a .env.local y completa tus credenciales
# NUNCA subas .env.local a control de versiones (Git)

# ===============================================
# Supabase (Obligatorio)
# ===============================================
# Obtén estos valores en tu panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de servicio para operaciones del lado del servidor (opcional / admin)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ===============================================
# Configuración del Sitio Web
# ===============================================
NEXT_PUBLIC_SITE_URL=https://saludmentaltemuco.cl
NEXT_PUBLIC_SITE_NAME=Salud Mental Temuco

# ===============================================
# Información de Contacto y Atención
# ===============================================
NEXT_PUBLIC_CONTACT_EMAIL=contacto@saludmentaltemuco.cl
NEXT_PUBLIC_CONTACT_PHONE=+56998671023
NEXT_PUBLIC_CONTACT_WHATSAPP=56998671023
NEXT_PUBLIC_CONTACT_ADDRESS=Temuco, Región de La Araucanía, Chile

# ===============================================
# Enlaces de Redes Sociales
# ===============================================
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/saludmentaltemuco
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/saludmentaltemuco
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/saludmentaltemuco

# ===============================================
# Correo Electrónico (Notificaciones de Leads)
# ===============================================
# Si utilizas Resend para enviar avisos de nuevas consultas
RESEND_API_KEY=re_tu_api_key_aqui
EMAIL_FROM=noreply@saludmentaltemuco.cl
NOTIFICATION_EMAIL=contacto@saludmentaltemuco.cl

# ===============================================
# Analytics y Métricas
# ===============================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===============================================
# Entorno
# ===============================================
NODE_ENV=development